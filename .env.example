# Copy this file to .env and set real values before running `docker compose up`.
# .env is read automatically by docker compose; do not commit your real .env.

EAP_ADMIN_PASSWORD=ChangeMeAdmin123!
EAP_SLAVE_PASSWORD=ChangeMeSlave123!

# WildFly release used as the open-source stand-in for JBoss EAP 7.4
# (EAP 7.4's server core tracks WildFly ~26).
WILDFLY_VERSION=26.1.3.Final
